;; Minibuffer history file, automatically generated by ‘savehist’.

(setq savehist-minibuffer-history-variables '(eww-prompt-history minibuffer-history read-expression-history extended-command-history))
(setq eww-prompt-history '("https://bilibili.com"))
(setq read-expression-history '("(set-frame-parameter nil 'alpha-background 50)" "(set-frame-parameter nil 'alpha 100)" "(set-frame-parameter nil 'alpha 50)" "(string-match-p \"NS_IMPL_COCOA\" system-configuration-options)" "system-configuration-options" "(set-frame-parameter nil 'alpha-background 50)" "(list invocation-directory)" "(list invocation-directory system-configuration-options)" "(set-frame-parameter nil 'alpha 100)" "(set-frame-parameter nil 'alpha 50)" "(set-frame-parameter nil 'alpha-background 50)"))
(setq extended-command-history '("eval-expression" "eww" "emacs-version"))
